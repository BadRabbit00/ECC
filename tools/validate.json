{
  "limits": {
    "core": 150,
    "contract": 40,
    "rule": 120,
    "agent": 300,
    "outputStyle": 220
  },
  "allowedModels": [
    "sonnet",
    "opus",
    "haiku",
    "fable",
    "inherit"
  ],
  "allowedEffort": [
    "low",
    "medium",
    "high",
    "xhigh",
    "max"
  ],
  "requiredDisallowed": [
    "Agent",
    "Skill",
    "mcp__*"
  ],
  "forbiddenDescriptionWords": [
    "proactively",
    "must be used",
    "use immediately",
    "automatically"
  ],
  "examplesExempt": [
    "agent:nix-architect",
    "agent:nix-build-resolver",
    "agent:nix-engineer",
    "agent:nix-test-runner"
  ],
  "hookEvents": [
    "PreToolUse",
    "PostToolUse",
    "UserPromptSubmit",
    "Stop",
    "SubagentStop",
    "SessionStart",
    "SessionEnd",
    "PreCompact",
    "Notification"
  ],
  "maxHookTimeout": 30,
  "styleMarker": "BR-ORCHESTRATOR-STYLE-ACTIVE",
  "docTemplates": [
    "GENERAL.md",
    "API.md",
    "DATABASE.md",
    "STRUCTURE.md",
    "ENTITY.md",
    "METHOD.md",
    "SPECIFICATION.md",
    "PATTERN.md",
    "POLICY.md",
    "OVERVIEW.md",
    "example_db.dbml"
  ],
  "buildIsolated": [
    "nix-architect",
    "nix-build-resolver",
    "nix-engineer",
    "nix-test-runner"
  ],
  "useWhenExempt": [
    "api-design",
    "cost-aware-llm-pipeline",
    "dart-flutter-patterns",
    "database-migrations",
    "docker-patterns",
    "documentation-lookup",
    "e2e-testing",
    "golang-patterns",
    "homelab-network-readiness",
    "homelab-network-setup",
    "homelab-pihole-dns",
    "homelab-vlan-segmentation",
    "homelab-wireguard-vpn",
    "mcp-server-patterns",
    "network-config-validation",
    "nix-debugging",
    "nix-flake-patterns",
    "nixos-module-patterns",
    "nix-packaging",
    "nix-testing",
    "nix-toolkit",
    "postgres-patterns",
    "project-flake",
    "prompt-caching-strategy",
    "react-patterns",
    "recsys-pipeline-architect",
    "redis-patterns",
    "rust-patterns",
    "vite-patterns"
  ]
}
